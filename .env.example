# Optional: Google-Gemini-Schlüssel für die KI-Spulenerkennung per Foto.
# Ohne Schlüssel läuft die App normal, nur die Foto-Erkennung nutzt dann eine einfache Offline-Erkennung.
# GEMINI_API_KEY=

# Zugangsschutz für alle /api-Routen: jeder Aufruf braucht den Header x-api-key (Bilder/Stream: ?k=).
# Die Home-Assistant-App erzeugt den Schlüssel selbst (steht im Protokoll). Lokal ohne Schlüssel geht nur localhost.
# APP_API_KEY=

# Optional: Erlaubte Ursprünge für Cross-Origin-Zugriffe (kommagetrennt). Ohne Angabe ist keiner erlaubt.
# CORS_ORIGIN=https://dein-name.github.io


# Bambu Cloud: Zertifikat prüfen (Standard an). Nur bei Problemen mit Firmen-Proxy auf false setzen.
# BAMBU_TLS_VERIFY=true
