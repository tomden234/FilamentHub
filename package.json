{
  "name": "filamenthub",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=server-dist/server.mjs --external:vite --external:sharp --external:ffmpeg-static --banner:js=\"import {createRequire as __cr} from 'module';const require=__cr(import.meta.url);\"",
    "build:electron": "esbuild electron/main.src.cjs --bundle --platform=node --external:electron --outfile=electron/main.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "basic-ftp": "^6.2.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "imapflow": "^2.11.0",
    "lucide-react": "^1.70.0",
    "mailparser": "^3.14.2",
    "mqtt": "^5.16.1",
    "nodemailer": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.cjs",
  "description": "FilamentHub: Filament-Verwaltung und Bambu-Drucker-Steuerung",
  "author": "tomden234",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomden234/filament-website-google-ai.git"
  },
  "homepage": "https://github.com/tomden234/filament-website-google-ai#readme",
  "bugs": {
    "url": "https://github.com/tomden234/filament-website-google-ai/issues"
  },
  "keywords": [
    "filament",
    "3d-printing",
    "bambu-lab",
    "ams",
    "home-assistant",
    "nfc",
    "inventory",
    "react",
    "capacitor",
    "electron"
  ]
}
